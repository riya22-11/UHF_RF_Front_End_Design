				NumParts=1
				ModSinceLib=false
				Terminal('positive', 'positive', 'A', false, 0, 1, '', 'Electrical', '0')
				Terminal('negative', 'negative', 'A', false, 1, 1, '', 'Electrical', '0')
				CompExtID=1
				$begin 'Parameters'
					TextProp('LabelID', 'HD', 'Property string for netlist ID', 'V@ID')
					VariableProp('ACMAG', 'D', 'AC magnitude for small-signal analysis (Volts)', 'nan V')
					VariablePropNU('ACPHASE', 'D', 'AC phase for small-signal analysis', '0deg', 'deg', AdditionalPropInfo='')
					VariableProp('V1', 'D', 'Initial and final voltage (Volts)', '0V')
					VariableProp('V2', 'D', 'Pulse voltage (Volts)', '0V')
					VariableProp('TD', 'D', '(Positive) delay time to start of upramp (seconds)', '0s')
					VariableProp('TR', 'D', 'Risetime from V1 to V2 (seconds)', '0s')
					VariableProp('TF', 'D', 'Falltime from V2 to V1 (seconds)', '0s')
					VariableProp('PW', 'D', 'Pulse width (V2 hold time) (seconds)', '1e+100s')
					VariableProp('PER', 'D', 'Period of repetition for trapezoidal pulse (seconds)', '1.5e+100s')
					VariableProp('TONE', 'D', 'Frequency (Hz) to use for harmonic balance analysis, should be a submultiple of (or equal to) the driving frequency and should also be included in the HB analysis setup', '0Hz')
					TextProp('ModelName', 'SHD', '', 'V_PULSE')
					ButtonProp('CosimDefinition', 'D', '', 'Edit', 'Edit', 40501, ButtonPropClientData())
					MenuProp('CoSimulator', 'D', '', 'DefaultNetlist', 0)
				$end 'Parameters'
				$begin 'CosimDefinitions'
					$begin 'CosimDefinition'
						CosimulatorType=4
						CosimDefName='DefaultNetlist'
						IsDefinition=true
						Connect=true
						Data(HSpice='V@ID %0 %1 PULSE(?V1(@V1) ?V2(@V2) ?TD(@TD) ?TR(@TR) ?TF(@TF) *PW(@PW) *PER(@PER)) *TONE(TONE=@TONE) *ACMAG(AC @ACMAG @ACPHASE)', 'Nexxim Circuit'='V@ID %0 %1 PULSE(?V1(@V1) ?V2(@V2) ?TD(@TD) ?TR(@TR) ?TF(@TF) ?PW(@PW) ?PER(@PER)) *TONE(TONE=@TONE) *ACMAG(AC @ACMAG @ACPHASE)')
						GRef(HSpice='', 'Nexxim Circuit'='')
					$end 'CosimDefinition'
					DefaultCosim='DefaultNetlist'
				$end 'CosimDefinitions'
			$end 'V_PULSE'
