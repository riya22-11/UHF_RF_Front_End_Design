				NumParts=1
				ModSinceLib=false
				Terminal('n1', 'n1', 'A', false, 1, 1, '', 'Electrical', '')
				Terminal('n2', 'n2', 'A', false, 2, 1, '', 'Electrical', '')
				CompExtID=1
				$begin 'Parameters'
					TextProp('LabelID', 'HD', 'Property string for netlist ID', 'L@ID')
					TextProp('DeviceModel', 'D', 'Name of device model', 'Enter model name')
					VariableProp('L', 'D', 'Inductance (H)', '0')
					VariableProp('SCALE', 'D', 'Inductance scaling factor', '1')
					VariableProp('M', 'D', 'Multiplier to simulate multiple parallel inductors', '1')
					VariableProp('DTEMP', 'D', 'Temperature difference between the inductor and the circuit (Cel)', '0')
					VariableProp('TNOM', 'D', 'Nominal temperature (Cel)', '25')
					VariableProp('TC1', 'D', 'First order temperature coefficient (1/K)', '0')
					VariableProp('TC2', 'D', 'Second order temperature coefficient (1/K^2)', '0')
					VariableProp('R', 'D', 'Series parasitic resistance (Ohm)', '0')
					VariableProp('Rpar', 'D', 'Parallel parasitic resistance (Ohm)', 'nan ')
					VariableProp('Cpar', 'D', 'Parallel parasitic capacitance (F)', '0')
					VariablePropNU('IC', 'D', 'Initial current through the inductor', 'nan A', 'A', AdditionalPropInfo='')
					TextProp('ModelName', 'SHD', '', 'IND_Device')
					ButtonProp('CosimDefinition', 'SD', '', 'Edit', 'Edit', 40501, ButtonPropClientData())
					MenuProp('CoSimulator', 'D', '', 'DefaultNetlist', 0)
