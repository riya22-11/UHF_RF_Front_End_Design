					$begin 'CosimDefinition'
						CosimulatorType=4
						CosimDefName='DefaultNetlist'
						IsDefinition=true
						Connect=false
						Data('Nexxim Circuit'='L@ID %0 %1 *DeviceModel(@DeviceModel) *L(L=@L) *TC1(TC1=@TC1) *TC2(TC2=@TC2) *SCALE(SCALE=@SCALE) *M(M=@M) *DTEMP(DTEMP=@DTEMP) *TNOM(TNOM=@TNOM) *R(R=@R) *Rpar(Rpar=@Rpar) *Cpar(Cpar=@Cpar) *IC(IC=@IC)')
						GRef('Nexxim Circuit'='')
					$end 'CosimDefinition'
					DefaultCosim='DefaultNetlist'
				$end 'CosimDefinitions'
			$end 'IND_Device'
			$begin 'CAP_Device'
				Library='Nexxim Circuit Elements\\Capacitors'
				CircuitEnv=0
				Refbase='C'
				NumParts=1
				ModSinceLib=false
				Terminal('positive', 'positive', 'A', false, 0, 1, '', 'Electrical', '')
				Terminal('negative', 'negative', 'A', false, 0, 1, '', 'Electrical', '')
				CompExtID=1
				$begin 'Parameters'
					TextProp('LabelID', 'HD', 'Property string for netlist ID', 'C@ID')
					VariablePropNU('C', 'D', 'Capacitance - If not provided, calculated from geometry, otherwise set to CAP from model', 'nan ', 'farad', AdditionalPropInfo='')
					TextProp('DeviceModel', 'D', 'Name of capacitor model', 'Enter model name')
					VariableProp('TC1', 'D', 'First-order temperature coefficient (1/deg K)', '0')
					VariableProp('TC2', 'D', 'Second-order temperature coefficient (1/deg K^2)', '0')
					VariableProp('SCALE', 'D', 'Scale factor for capacitance', '1')
					VariablePropNU('W', 'D', 'Capacitor width', '0meter', 'meter', AdditionalPropInfo='')
					VariablePropNU('L', 'D', 'Capacitor length', '0meter', 'meter', AdditionalPropInfo='')
					VariableProp('M', 'D', 'Multiplier to simulate capacitors in parallel', '1')
					VariableProp('Rser', 'D', 'Series resistance (Ohm)', '0')
					VariableProp('Rpar', 'D', 'Parallel resistance (Ohm)', 'nan ')
					VariableProp('Cpar', 'D', 'Parallel capacitance (F)', '0')
					VariableProp('Lser', 'D', 'Series inductance (H)', '0')
					VariableProp('RLshunt', 'D', 'Parallel resistance of Lser (Ohm)', 'nan ')
					VariablePropNU('DTEMP', 'D', 'Temperature difference between capacitor and circuit', '0cel', 'cel', AdditionalPropInfo='')
					ValuePropNU('IC', 'D', 'Initial voltage across capacitor', 'nan V', 0, 'V', AdditionalPropInfo='')
