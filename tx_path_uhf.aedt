			$begin 'RES_'
				Library='Nexxim Circuit Elements\\Resistors'
				CircuitEnv=0
				Refbase='R'
				NumParts=1
				ModSinceLib=false
				Terminal('terminals_0', 'terminals_0', 'A', false, 6, 1, '', 'Electrical', '0')
				Terminal('terminals_1', 'terminals_1', 'A', false, 7, 1, '', 'Electrical', '0')
				CompExtID=1
				$begin 'Parameters'
					TextProp('LabelID', 'HD', 'Property string for netlist ID', 'R@ID')
					VariableProp('R', 'D', 'Resistance (Ohm)', '50')
					MenuProp('ADD_NOISE', 'HD', '1=generate noise data, 0=no noise data', '0,1', 1)
					VariablePropNU('DTEMP', 'HD', 'Diff betw device temp and circuit temp', '0cel', 'cel', AdditionalPropInfo='')
					TextProp('ModelName', 'SHD', '', 'RES_')
					ButtonProp('CosimDefinition', 'D', '', 'Edit', 'Edit', 40501, ButtonPropClientData())
					MenuProp('CoSimulator', 'D', '', 'DefaultNetlist', 0)
				$end 'Parameters'
				$begin 'CosimDefinitions'
					$begin 'CosimDefinition'
						CosimulatorType=4
						CosimDefName='DefaultNetlist'
						IsDefinition=true
						Connect=true
						Data('Nexxim Circuit'='R@ID %0 %1 ?R(@R) *ADD_NOISE(NOISE=@ADD_NOISE) *DTEMP(DTEMP=@DTEMP)')
						GRef('Nexxim Circuit'='')
					$end 'CosimDefinition'
					DefaultCosim='DefaultNetlist'
				$end 'CosimDefinitions'
			$end 'RES_'
			$begin 'IND_Device'
				Library='Nexxim Circuit Elements\\Inductors'
				CircuitEnv=0
				Refbase='L'
				NumParts=1
				ModSinceLib=false
				Terminal('n1', 'n1', 'A', false, 1, 1, '', 'Electrical', '')
				Terminal('n2', 'n2', 'A', false, 2, 1, '', 'Electrical', '')
				CompExtID=1
				$begin 'Parameters'
					TextProp('LabelID', 'HD', 'Property string for netlist ID', 'L@ID')
					TextProp('DeviceModel', 'D', 'Name of device model', 'Enter model name')
					VariableProp('L', 'D', 'Inductance (H)', '0')
					VariableProp('SCALE', 'D', 'Inductance scaling factor', '1')
					VariableProp('M', 'D', 'Multiplier to simulate multiple parallel inductors', '1')
					VariableProp('DTEMP', 'D', 'Temperature difference between the inductor and the circuit (Cel)', '0')
					VariableProp('TNOM', 'D', 'Nominal temperature (Cel)', '25')
					VariableProp('TC1', 'D', 'First order temperature coefficient (1/K)', '0')
					VariableProp('TC2', 'D', 'Second order temperature coefficient (1/K^2)', '0')
					VariableProp('R', 'D', 'Series parasitic resistance (Ohm)', '0')
					VariableProp('Rpar', 'D', 'Parallel parasitic resistance (Ohm)', 'nan ')
					VariableProp('Cpar', 'D', 'Parallel parasitic capacitance (F)', '0')
					VariablePropNU('IC', 'D', 'Initial current through the inductor', 'nan A', 'A', AdditionalPropInfo='')
					TextProp('ModelName', 'SHD', '', 'IND_Device')
					ButtonProp('CosimDefinition', 'SD', '', 'Edit', 'Edit', 40501, ButtonPropClientData())
					MenuProp('CoSimulator', 'D', '', 'DefaultNetlist', 0)
				$end 'Parameters'
				$begin 'CosimDefinitions'
					$begin 'CosimDefinition'
						CosimulatorType=4
						CosimDefName='DefaultNetlist'
						IsDefinition=true
						Connect=false
						Data('Nexxim Circuit'='L@ID %0 %1 *DeviceModel(@DeviceModel) *L(L=@L) *TC1(TC1=@TC1) *TC2(TC2=@TC2) *SCALE(SCALE=@SCALE) *M(M=@M) *DTEMP(DTEMP=@DTEMP) *TNOM(TNOM=@TNOM) *R(R=@R) *Rpar(Rpar=@Rpar) *Cpar(Cpar=@Cpar) *IC(IC=@IC)')
						GRef('Nexxim Circuit'='')
					$end 'CosimDefinition'
					DefaultCosim='DefaultNetlist'
				$end 'CosimDefinitions'
			$end 'IND_Device'
